# Copiar como .env (ignorado por Git) y completar. No subas el .env al repositorio.

# --- Brokers -----------------------------------------------------------------
# Nombre o IP con que los clientes que están FUERA de Docker llegan a los brokers.
#   En tu PC: localhost
#   En la EC2: su IP PRIVADA (no la pública), por ejemplo 10.0.20.50
KAFKA_EXTERNAL_HOST=localhost

# Interfaz donde se publican los puertos 9092, 9093 y 9094.
#   En tu PC: 127.0.0.1
#   En la EC2, si Shipments corre en otra EC2: 0.0.0.0, y en el security group abre
#   9092-9094 solo para el security group de Shipments (nunca para 0.0.0.0/0).
KAFKA_BIND_ADDRESS=127.0.0.1

# Memoria de cada broker. En una EC2 con 4 GB usa -Xms256m -Xmx384m.
KAFKA_HEAP_OPTS=-Xms256m -Xmx512m

# --- Kafka-UI ----------------------------------------------------------------
KAFKA_UI_USER=admin
# Obligatoria. Elige una contraseña propia; no la reutilices de otro servicio.
KAFKA_UI_PASSWORD=
# 127.0.0.1 en tu PC. En la EC2: 0.0.0.0, con el puerto 8089 abierto solo para tu IP.
KAFKA_UI_BIND_ADDRESS=127.0.0.1

# --- kafka-admin (perfil "app") ---------------------------------------------
# 127.0.0.1 = solo desde la misma máquina. 0.0.0.0 si otra EC2 debe llamar la API.
KAFKA_ADMIN_BIND_ADDRESS=127.0.0.1
